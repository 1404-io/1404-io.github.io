---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../lib/constants';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'What happens on the first call with 1404?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'We spend 30 minutes learning about your business. No pitch deck. No sales script. We want to understand your operations, your team, where you are trying to grow, and what is slowing you down. If there is a fit, we outline what a partnership with 1404 would look like for your company. If there is not, we tell you.',
      },
    },
    {
      '@type': 'Question',
      'name': 'How does an engagement start?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'It starts with a one-time Foundation. We come on-site, put the best AI tools in your team\'s hands and get them fluent, connect the systems you already run so they work as one, and build a clear AI plan from your growth goals. From there it becomes an ongoing Partnership on a flat monthly retainer, where we keep building whatever moves the business forward and share in the upside we create.',
      },
    },
  ],
};
---

<PageLayout
  title="Contact 1404 — Start a conversation"
  description="Start a conversation with 1404. 30 minutes, no pitch deck. We'll learn about your business and tell you what's possible."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="max-w-4xl mx-auto px-6 pt-40 pb-24 md:pb-32">

    <!-- Header -->
    <header class="mb-16">
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-text-primary leading-tight">
        Start a Conversation
      </h1>
      <p class="text-text-secondary text-lg mt-6 leading-relaxed max-w-xl">
        No pitch deck. Reach out to either of us and we'll take it from there.
      </p>
    </header>

    <!-- Reach out — Primary -->
    <div class="mb-20 space-y-6">
      <p class="text-xs tracking-widest uppercase text-text-muted mb-3">Reach out to either of us</p>
      <div>
        <a
          href={`mailto:${SITE.emailArthur}`}
          class="text-copper text-xl hover:text-copper-bright transition-colors duration-200"
        >
          {SITE.emailArthur}
        </a>
        <span class="text-text-muted text-sm ml-2">Arthur Skatoff</span>
      </div>
      <div>
        <a
          href={`mailto:${SITE.email}`}
          class="text-copper text-xl hover:text-copper-bright transition-colors duration-200"
        >
          {SITE.email}
        </a>
        <span class="text-text-muted text-sm ml-2">Holden Bryce</span>
      </div>
      <div>
        <a
          href={`tel:${SITE.phone}`}
          class="text-copper text-xl hover:text-copper-bright transition-colors duration-200"
        >
          {SITE.phone}
        </a>
      </div>
    </div>

    <!-- What to Expect -->
    <div class="border-t border-border pt-16">
      <h2 class="font-display text-2xl md:text-3xl text-text-primary mb-8">What to Expect</h2>

      <div class="space-y-6 text-text-body text-base leading-relaxed">
        <p>
          We'll start by learning about your business. No pitch deck. No sales script. We want to understand your operations, your team, where you're trying to grow, and what's slowing you down.
        </p>
        <p>
          If there's a fit, we'll outline what a partnership with 1404 looks like for your company. Where we'd start, what we'd build first, and what the investment looks like. Specific enough to make a decision on.
        </p>
        <p>
          If there isn't a fit, we'll tell you that too. We've turned down work that wasn't the right match, and we'd rather be honest about it upfront.
        </p>
      </div>
    </div>

    <!-- How an engagement starts -->
    <div class="mt-20 bg-bg-card border border-border-light p-8 md:p-10">
      <p class="text-xs tracking-widest uppercase text-text-muted mb-6">How an engagement starts</p>

      <div class="space-y-6 text-text-body text-sm leading-relaxed">
        <p>
          <span class="text-text-primary font-medium">Foundation.</span> A one-time, on-site setup. We get your people running with the best AI tools, connect the systems you already use so they work as one, and build a clear AI plan from where you want to grow.
        </p>
        <p>
          <span class="text-text-primary font-medium">Partnership.</span> An ongoing flat monthly retainer. We keep building whatever moves the business forward, from AI agents to custom software, and improve it as you grow.
        </p>
        <p>
          <span class="text-text-primary font-medium">Shared upside.</span> Beyond the retainer, we earn a share of the value we create each quarter. Our reward grows as yours does.
        </p>
      </div>
    </div>

  </section>
</PageLayout>
