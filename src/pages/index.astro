---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTABanner from '../components/CTABanner.astro';
import ClientLogos from '../components/ClientLogos.astro';
import { PHASES, DIFFERENTIATORS, PROCESS } from '../lib/constants';
---

<PageLayout
  title="1404 — A transformational technology partner"
  description="Forward-deployed software engineers who work inside your business, building and running an AI strategy aligned with your growth plan. We work on a flat retainer and share in the upside we create together."
>
  <!-- Hero -->
  <Hero />

  <!-- MIT / strategy band -->
  <section class="max-w-5xl mx-auto px-6 py-24 md:py-32">
    <div class="border-l-2 border-copper pl-8 md:pl-10">
      <p class="text-text-body text-lg md:text-xl leading-relaxed">
        <span class="text-text-primary font-medium">About 95% of enterprise AI efforts deliver no return.</span> That's the finding of MIT's 2025 study, <span class="text-text-primary font-medium">"The GenAI Divide."</span> The tools work. What MIT found is that generic tools <span class="italic text-text-primary">"stall in enterprise use since they don't learn from or adapt to workflows."</span> A stack of tools is not a strategy. AI is a strategy, and it only becomes meaningful when it's built around how your business runs, and refined over time. That's what we do.
      </p>
    </div>
  </section>

  <!-- What we do -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-6 py-24 md:py-32">
      <SectionHeading title="What we do for you" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {PHASES.map((phase) => (
          <div class="border border-copper-dim rounded-sm p-8 bg-bg-card">
            <p class="font-mono text-xs text-copper mb-4 tracking-wide uppercase">{phase.kicker}</p>
            <h3 class="font-display text-2xl md:text-3xl text-text-primary mb-3">{phase.title}</h3>
            <p class="text-text-secondary text-sm italic leading-relaxed mb-8">{phase.descriptor}</p>
            <ul class="space-y-5">
              {phase.bullets.map((b) => (
                <li class="text-text-body text-base leading-relaxed">
                  <span class="text-text-primary font-medium">{b.lead}</span> {b.rest}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why it's different -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-6 py-24 md:py-32">
      <SectionHeading title="Why it's different" />

      <div class="space-y-10">
        {DIFFERENTIATORS.map((d) => (
          <div class="border-l-2 border-copper-dim pl-8">
            <h3 class="font-display text-xl md:text-2xl text-text-primary mb-2">{d.title}</h3>
            <p class="text-text-body text-base leading-relaxed max-w-3xl">{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-6 py-24 md:py-32">
      <SectionHeading
        title="How we work"
        subtitle="Every problem, the same way."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6">
        {PROCESS.map((p, i) => (
          <div>
            <p class="font-mono text-3xl md:text-4xl text-copper mb-4 tracking-wide">0{i + 1}</p>
            <h3 class="font-display text-2xl text-text-primary mb-3">{p.step}</h3>
            <p class="text-text-body text-base leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proof: The Construct Group -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-6 py-24 md:py-32">
      <SectionHeading title="Built inside a real operating company" />

      <div class="space-y-6 text-text-body text-base leading-relaxed mb-12 max-w-3xl">
        <p>
          The Construct Group, a national retail fixture installation company, was our first partner. We built their technology from the ground up. A unified operations platform with twelve integrated modules, AI agents running daily operations, and ongoing technology leadership. The results were significant enough that TCG came on as an equity partner.
        </p>
        <p>
          TCG still runs on our platform today, and their CEO actively introduces us to other operators. That's how most of our partners find us. Everything we do was built and proven in production before we took a second partner.
        </p>
      </div>

      <a href="/case-studies/tcg" class="text-sm text-copper hover:text-copper-bright transition-colors duration-200">
        Read the full case study &rarr;
      </a>
    </div>
  </section>

  <!-- Trust -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-6 py-24 md:py-32">
      <SectionHeading title="Built for the businesses that run due diligence" />

      <p class="text-text-body text-base leading-relaxed mb-12 max-w-3xl">
        We work inside your infrastructure. Financials, email, project data. That level of access calls for real security and compliance, so we built it early. The companies we want to work with check before they grant that kind of access, and we want them to.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
        <div class="border border-border-light rounded-sm px-5 py-4 bg-bg-card">
          <p class="font-mono text-xs text-copper mb-1 tracking-wide">SOC 2 Type II</p>
          <p class="text-text-secondary text-sm">In progress</p>
        </div>
        <div class="border border-border-light rounded-sm px-5 py-4 bg-bg-card">
          <p class="font-mono text-xs text-copper mb-1 tracking-wide">Security Policies</p>
          <p class="text-text-secondary text-sm">14 policies written</p>
        </div>
        <div class="border border-border-light rounded-sm px-5 py-4 bg-bg-card">
          <p class="font-mono text-xs text-copper mb-1 tracking-wide">AI Governance</p>
          <p class="text-text-secondary text-sm">NIST AI RMF aligned</p>
        </div>
        <div class="border border-border-light rounded-sm px-5 py-4 bg-bg-card">
          <p class="font-mono text-xs text-copper mb-1 tracking-wide">Client Isolation</p>
          <p class="text-text-secondary text-sm">Dedicated infrastructure per client</p>
        </div>
      </div>

      <a href="/trust" class="text-sm text-copper hover:text-copper-bright transition-colors duration-200">
        Full security and compliance details &rarr;
      </a>
    </div>
  </section>

  <!-- Client Logos -->
  <ClientLogos />

  <!-- CTA -->
  <CTABanner />
</PageLayout>
