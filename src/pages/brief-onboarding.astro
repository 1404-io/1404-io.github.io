---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="1404 — Daily Brief"
  description="Build your daily brief. About 5 minutes."
  noindex={true}
>
  <div class="max-w-3xl mx-auto px-6 py-16">

    <!-- Intro screen (default visible) -->
    <div id="intro" class="onboarding-step">
      <p class="font-mono text-xs text-copper mb-4 tracking-wide">DAILY BRIEF</p>
      <h1 class="font-display text-4xl md:text-5xl text-text-primary mb-6 leading-tight">
        Build your daily brief.
      </h1>
      <p class="text-text-body text-lg leading-relaxed mb-6">
        8 questions, about 10 minutes. We'll send your first brief to your inbox tomorrow morning.
      </p>
      <div id="prefill-banner" class="hidden mb-6 p-4 border border-copper rounded-sm bg-bg-card">
        <p class="font-mono text-xs text-copper tracking-wide mb-2">PRE-FILLED FROM OUR CALLS</p>
        <p class="text-text-body text-sm">We've drafted answers where we could. Highlighted in copper — confirm or change.</p>
      </div>
      <div class="mb-6 p-4 border-l-2 border-copper bg-bg-card">
        <p class="font-mono text-xs text-copper tracking-wide mb-2">WHAT YOU GET, WHEN</p>
        <p class="text-text-body text-sm leading-relaxed">
          Day 1 brief reads from your email, calendar, and what you tell us here. The numbers from your accounting system (cash, AR, margin) come online once we connect it — usually 7–10 days. Project and operations tools (workload, materials, schedule, pipeline) take 30–45 days. Brief gets stronger as each piece connects.
        </p>
      </div>
      <p class="text-text-secondary text-sm mb-8">
        Your answers go directly to your 1404 onboarder. Nothing is shared externally.
      </p>
      <button class="advance-btn" data-target="step-1">
        Start &rarr;
      </button>
    </div>

    <!-- Progress bar -->
    <div id="progress-wrap" class="hidden sticky top-0 bg-bg pt-4 pb-2 z-10">
      <div class="flex justify-between text-xs text-text-muted font-mono mb-2">
        <span id="step-label">Step 1 of 8</span>
        <span id="step-name">Your ideal morning</span>
      </div>
      <div class="h-1 bg-border rounded">
        <div id="progress-bar" class="h-1 bg-copper rounded transition-all" style="width: 0%"></div>
      </div>
    </div>

    <!-- Step 1: Morning behavior + day-blocker -->
    <div id="step-1" class="onboarding-step hidden" data-section="Your morning" data-step="1">
      <h2 class="font-display text-3xl text-text-primary mb-6">Your morning</h2>

      <label class="form-label mb-8">What's the first thing you check on your phone in the morning?
        <p class="text-text-muted text-xs mb-2">Texts, email, schedule, news, weather, something else. And what are you usually looking for in it?</p>
        <textarea name="wishlist.morning_routine" class="form-input" rows="5"></textarea>
      </label>

      <label class="form-label">What's the one thing where, if you didn't know about it before 8am, your day would be a mess?
        <p class="text-text-muted text-xs mb-2">A person not showing up, an inspector arriving, a check bouncing, a major customer escalating — whatever the "oh no" is for you.</p>
        <textarea name="wishlist.day_blocker" class="form-input" rows="3"></textarea>
      </label>

      <div class="step-nav">
        <span></span>
        <button class="advance-btn" data-target="step-2">Continue &rarr;</button>
      </div>
    </div>

    <!-- Step 2: Self-identity (role + outcomes) -->
    <div id="step-2" class="onboarding-step hidden" data-section="Your role" data-step="2">
      <h2 class="font-display text-3xl text-text-primary mb-6">Your role</h2>

      <div class="form-grid">
        <label class="form-label">Your full name
          <input type="text" name="identity.name" class="form-input" required />
        </label>

        <label class="form-label">Work email
          <input type="email" name="identity.email" class="form-input" required placeholder="you@company.com" />
        </label>

        <label class="form-label full">Title
          <input type="text" name="identity.title" class="form-input" required placeholder="VP of Operations / CEO / etc." />
        </label>

        <label class="form-label full">What do you actually do day-to-day?
          <p class="text-text-muted text-xs mb-2">Doesn't have to match your title. Plain words are fine.</p>
          <textarea name="identity.role_summary" class="form-input" rows="2" required></textarea>
        </label>

        <label class="form-label full">What does a good week look like for you? How do you know you had one?
          <p class="text-text-muted text-xs mb-2">Same idea as "what are you measured on" but said the way you'd actually say it.</p>
          <textarea name="identity.good_week" class="form-input" rows="3"></textarea>
        </label>
      </div>

      <div class="step-nav">
        <button class="back-btn" data-target="step-1">&larr; Back</button>
        <button class="advance-btn" data-target="step-3">Continue &rarr;</button>
      </div>
    </div>

    <!-- Step 3: Tuesday morning -->
    <div id="step-3" class="onboarding-step hidden" data-section="A normal Tuesday" data-step="3">
      <h2 class="font-display text-3xl text-text-primary mb-6">A normal Tuesday</h2>
      <p class="text-text-body mb-6">Walk us through it, from when you wake up to when you sit down at your desk or get to your first appointment. Who do you talk to? What do you check? What's usually waiting for you when you get there?</p>

      <label class="form-label">
        <textarea name="morning_workflow.tuesday_morning" class="form-input" rows="8" placeholder="I wake at 5:30, check phone in bed, drive to the office or first job around 7. By the time I get there..."></textarea>
      </label>

      <div class="step-nav">
        <button class="back-btn" data-target="step-2">&larr; Back</button>
        <button class="advance-btn" data-target="step-4">Continue &rarr;</button>
      </div>
    </div>

    <!-- Step 4: Who you work with -->
    <div id="step-4" class="onboarding-step hidden" data-section="Who you work with" data-step="4">
      <h2 class="font-display text-3xl text-text-primary mb-6">Who you work with</h2>

      <label class="form-label">In one or two lines, who do you work with most?
        <p class="text-text-muted text-xs mb-2">Names are great if it's a small group. If it's bigger, just describe it — "the field crew", "the office team", "the four division heads", "everyone in ops". M365 fills in the rest later.</p>
        <textarea name="org.direct_reports_group" class="form-input" rows="3"></textarea>
      </label>

      <details class="mt-8">
        <summary class="text-copper text-sm cursor-pointer hover:text-copper-bright">Want to list direct reports individually? Click to expand.</summary>
        <p class="text-text-muted text-xs mt-3 mb-3">Name, email, title, and what each one owns. Skip any field you don't have handy.</p>
        <div id="reports-list">
          <div class="report-row">
            <input type="text" class="form-input" placeholder="Name" data-key="name" />
            <input type="email" class="form-input" placeholder="Email" data-key="email" />
            <input type="text" class="form-input" placeholder="Title" data-key="title" />
            <input type="text" class="form-input" placeholder="What they own" data-key="lane" />
          </div>
        </div>
        <button id="add-report" class="text-copper text-sm hover:text-copper-bright mt-2" type="button">+ Add another</button>
      </details>

      <div class="step-nav">
        <button class="back-btn" data-target="step-3">&larr; Back</button>
        <button class="advance-btn" data-target="step-5">Continue &rarr;</button>
      </div>
    </div>

    <!-- Step 5: 3 things on a page -->
    <div id="step-5" class="onboarding-step hidden" data-section="Three things on a page" data-step="5">
      <h2 class="font-display text-3xl text-text-primary mb-6">Three things on a page</h2>
      <p class="text-text-body mb-6">If we put 3 things on a single page that you'd want to see every morning, what would they be?</p>

      <label class="form-label">
        <p class="text-text-muted text-xs mb-2">Examples from real briefs: today's jobs and crews, who's out, AR over 30 days, weather and forecast, jobs running over budget, callbacks waiting. Whatever matters to you.</p>
        <input type="text" name="brief_priorities.0" class="form-input mb-2" placeholder="The most important thing" />
        <input type="text" name="brief_priorities.1" class="form-input mb-2" placeholder="The second" />
        <input type="text" name="brief_priorities.2" class="form-input" placeholder="The third" />
      </label>

      <details class="mt-8">
        <summary class="text-copper text-sm cursor-pointer hover:text-copper-bright">Or pick from common sections (optional)</summary>
        <p class="text-text-muted text-xs mt-3 mb-3">Pre-built sections we already know how to render. Pick any that match what you wrote above.</p>
        <div id="sections-grid" class="sections-grid">
          <!-- Populated via JS from SECTION_CATALOG -->
        </div>
      </details>

      <div class="step-nav">
        <button class="back-btn" data-target="step-4">&larr; Back</button>
        <button class="advance-btn" data-target="step-6">Continue &rarr;</button>
      </div>
    </div>

    <!-- Step 6: What should interrupt you -->
    <div id="step-6" class="onboarding-step hidden" data-section="What should interrupt you" data-step="6">
      <h2 class="font-display text-3xl text-text-primary mb-6">What should interrupt you</h2>

      <label class="form-label">What's the kind of thing where you'd want a text or call right now, not tomorrow?
        <p class="text-text-muted text-xs mb-2">A job got shut down, a customer is angry, payroll is short, someone got hurt, a check bounced, an inspector showed up — whatever the "interrupt me" list is for you.</p>
        <textarea name="red_flags_custom" class="form-input" rows="4"></textarea>
      </label>

      <details class="mt-6">
        <summary class="text-copper text-sm cursor-pointer hover:text-copper-bright">Or pick from common alerts (optional)</summary>
        <p class="text-text-muted text-xs mt-3 mb-3">Built-in alerts we already know how to detect.</p>
        <div id="trigger-grid" class="checkbox-group"></div>
      </details>

      <label class="form-label mt-8">Numbers you check regularly, or wish you did
        <p class="text-text-muted text-xs mb-2">Revenue, hours billed, jobs open, AR — anything. If none come to mind right now, leave blank. We'll suggest some after the first brief.</p>
        <input type="text" name="kpis_top.0" class="form-input mb-2" />
        <input type="text" name="kpis_top.1" class="form-input mb-2" />
        <input type="text" name="kpis_top.2" class="form-input mb-2" />
        <input type="text" name="kpis_top.3" class="form-input" />
      </label>

      <div class="step-nav">
        <button class="back-btn" data-target="step-5">&larr; Back</button>
        <button class="advance-btn" data-target="step-7">Continue &rarr;</button>
      </div>
    </div>

    <!-- Step 7: Rhythm & format -->
    <div id="step-7" class="onboarding-step hidden" data-section="Rhythm and format" data-step="7">
      <h2 class="font-display text-3xl text-text-primary mb-6">Rhythm and format</h2>

      <fieldset class="form-label">How much detail?
        <div class="radio-card-group mt-3">
          <label class="radio-card">
            <input type="radio" name="format.tone" value="add_friendly" />
            <strong>Short and punchy</strong>
            <span>Just the headlines.</span>
          </label>
          <label class="radio-card">
            <input type="radio" name="format.tone" value="exec_strategic" checked />
            <strong>Medium</strong>
            <span>Headlines plus a little context.</span>
          </label>
          <label class="radio-card">
            <input type="radio" name="format.tone" value="deep_data" />
            <strong>Detailed</strong>
            <span>Numbers and the why behind them.</span>
          </label>
        </div>
      </fieldset>

      <div class="form-grid mt-8">
        <label class="form-label">Send time (local)
          <input type="time" name="delivery.send_time_local" class="form-input" value="06:00" />
        </label>

        <fieldset class="form-label">Cadence
          <div class="radio-group">
            <label><input type="radio" name="delivery.cadence" value="mon_fri" checked /> Weekdays only</label>
            <label><input type="radio" name="delivery.cadence" value="daily" /> 7 days</label>
            <label><input type="radio" name="delivery.cadence" value="mon_wed_fri" /> Mon / Wed / Fri</label>
            <label><input type="radio" name="delivery.cadence" value="on_demand" /> On-demand only</label>
          </div>
        </fieldset>
      </div>

      <div class="step-nav">
        <button class="back-btn" data-target="step-6">&larr; Back</button>
        <button class="advance-btn" data-target="step-8">Continue &rarr;</button>
      </div>
    </div>

    <!-- Step 8: Who else should see this -->
    <div id="step-8" class="onboarding-step hidden" data-section="Who else should see this" data-step="8">
      <h2 class="font-display text-3xl text-text-primary mb-6">Who else should see this?</h2>

      <fieldset class="form-label">Pick anyone the brief should also go to.
        <div class="checkbox-group">
          <label><input type="checkbox" name="boundaries.shared_with" value="self" checked /> Just me</label>
          <label><input type="checkbox" name="boundaries.shared_with" value="EA" /> My EA</label>
          <label><input type="checkbox" name="boundaries.shared_with" value="manager" /> My manager</label>
          <label><input type="checkbox" name="boundaries.shared_with" value="team" /> My team</label>
        </div>
      </fieldset>

      <!-- Summary block -->
      <div class="mt-12 p-6 border border-copper rounded-sm bg-bg-card">
        <p class="font-mono text-xs text-copper tracking-wide mb-3">SUMMARY</p>
        <div id="summary-content" class="text-text-body text-sm space-y-2"></div>
      </div>

      <div class="step-nav mt-8">
        <button class="back-btn" data-target="step-7">&larr; Back</button>
        <button id="submit-btn" class="submit-btn">Build it &rarr;</button>
      </div>

      <div id="submit-result" class="hidden mt-6 p-6 border border-copper rounded-sm bg-bg-card">
        <p class="font-mono text-xs text-copper tracking-wide mb-3">DONE</p>
        <p class="text-text-body">Your first brief lands in your inbox tomorrow morning.</p>
      </div>
    </div>

  </div>
</PageLayout>

<style is:global>
  .onboarding-step {
    min-height: 60vh;
    animation: fadeIn 200ms ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .form-grid { grid-template-columns: 1fr 1fr; }
    .form-grid .form-label.full { grid-column: 1 / -1; }
  }
  .form-label {
    display: block;
    color: var(--color-text-body);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }
  .form-input {
    width: 100%;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    padding: 0.75rem 1rem;
    font-size: 1rem;
    margin-top: 0.4rem;
    border-radius: 2px;
    transition: border-color 200ms;
  }
  .form-input:focus {
    outline: none;
    border-color: var(--color-copper);
  }
  textarea.form-input { resize: vertical; min-height: 80px; }
  .radio-group, .checkbox-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .radio-group label, .checkbox-group label {
    color: var(--color-text-body);
    font-size: 0.9rem;
    cursor: pointer;
  }
  .radio-group input, .checkbox-group input {
    margin-right: 0.5rem;
    accent-color: var(--color-copper);
  }
  .radio-card-group {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .radio-card-group { grid-template-columns: repeat(3, 1fr); }
  }
  .radio-card {
    display: block;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: var(--color-bg-card);
    cursor: pointer;
    transition: border-color 200ms;
  }
  .radio-card:has(input:checked) {
    border-color: var(--color-copper);
    background: var(--color-bg-surface);
  }
  .radio-card input { display: none; }
  .radio-card strong {
    display: block;
    color: var(--color-text-primary);
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }
  .radio-card span {
    display: block;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    line-height: 1.4;
  }
  .step-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .advance-btn, .submit-btn, .back-btn {
    padding: 0.85rem 2rem;
    font-size: 0.95rem;
    border-radius: 2px;
    cursor: pointer;
    font-family: inherit;
    transition: background 200ms;
  }
  .advance-btn, .submit-btn {
    background: var(--color-copper);
    color: var(--color-bg);
    border: none;
    font-weight: 600;
  }
  .advance-btn:hover, .submit-btn:hover {
    background: var(--color-copper-bright);
  }
  .back-btn {
    background: transparent;
    color: var(--color-text-body);
    border: 1px solid var(--color-border);
  }
  .back-btn:hover {
    border-color: var(--color-copper);
    color: var(--color-text-primary);
  }
  .report-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  @media (max-width: 767px) {
    .report-row { grid-template-columns: 1fr; }
  }
  .sections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.6rem;
  }
  .section-card {
    padding: 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    cursor: pointer;
    background: var(--color-bg-card);
    transition: all 200ms;
  }
  .section-card:has(input:checked) {
    border-color: var(--color-copper);
    background: var(--color-bg-surface);
  }
  .section-card input { display: none; }
  .section-card .name {
    font-weight: 600;
    color: var(--color-text-primary);
    font-size: 0.85rem;
    margin-bottom: 0.25rem;
  }
  .section-card .desc {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.35;
    margin-bottom: 0.4rem;
  }
  .section-card .section-tags {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
    margin-top: 0.3rem;
  }
  .section-tag {
    font-size: 0.6rem;
    background: var(--color-bg-surface);
    color: var(--color-text-muted);
    padding: 0.1rem 0.4rem;
    border-radius: 2px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  /* Pre-fill highlighting */
  .prefilled {
    border-color: var(--color-copper) !important;
    background: var(--color-bg-surface);
  }
  .prefill-badge {
    display: inline-block;
    background: var(--color-copper);
    color: var(--color-bg);
    font-size: 0.65rem;
    padding: 0.1rem 0.45rem;
    border-radius: 2px;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-left: 0.5rem;
    vertical-align: middle;
    text-transform: uppercase;
  }
  .prefill-source {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
    font-style: italic;
  }
</style>

<script>
  // Section catalog — Day-1 sections only. No dependency on accounting or
  // project-tools integrations. Phase-2 sections (manpower_loading, materials_in_motion,
  // eos_scorecard_live, etc.) are intentionally absent — we'll re-ask once those land.
  const SECTION_CATALOG = [
    {id: 'one_liner', name: '30-second read', desc: 'Single-sentence summary at the top.'},
    {id: 'red_banner', name: 'Red banner', desc: 'Fires only if a trigger matches.'},
    {id: 'actions_today', name: 'Top 3 actions today', desc: 'Time-stamped things you must do today.'},
    {id: 'calendar_with_prep', name: 'Calendar with prep', desc: 'Today\'s meetings linked to live open threads.'},
    {id: 'inbox_needs_response', name: 'Inbox triage', desc: 'Strict-filter emails that need your reply.'},
    {id: 'conversations', name: 'Conversations needing reply', desc: 'Filtered email triage with suggested responses.'},
    {id: 'approvals_needed', name: 'Approvals waiting', desc: 'Timesheets, expenses, POs, change orders — color-coded.'},
    {id: 'direct_report_activity', name: 'Direct report activity', desc: 'Per-person card: sentiment, topics, pending for you.'},
    {id: 'team_pulse', name: 'Team pulse + standup agenda', desc: 'Per-report standup question.'},
    {id: 'what_changed', name: 'What changed since last brief', desc: 'New wins, closed items, aging, first-flagged patterns.'},
    {id: 'decisions_today', name: 'Decisions today', desc: 'Recommendations + cost of inaction.'},
    {id: 'risks', name: 'Risks & systemic patterns', desc: 'Cross-source pattern detection.'},
    {id: 'core_values_pulse', name: 'Core values pulse', desc: 'Behavior callouts with quoted evidence.'},
  ];

  // Trigger menu — for the red-flag question.
  // Day-1 only: triggers that fire from email/calendar signals. Cash/AR triggers
  // (cash_runway_critical, aged_ar_writeoff_risk) re-appear once accounting connects.
  // Project-tools triggers (manpower, material, submittal, RFI, EOS, rocks)
  // re-appear once those integrations land.
  const TRIGGER_MENU = [
    {id: 'customer_escalation', label: 'Escalation language from high-revenue customer'},
    {id: 'approvals_pile_up', label: 'Many approvals waiting (your team can\'t move)'},
    {id: 'critical_email_buried', label: 'Email from flagged sender, buried in M365 group'},
    {id: 'submittal_late', label: 'Submittal past spec window'},
    {id: 'rfi_overdue', label: 'RFI open >7 days'},
  ];

  const TOTAL_STEPS = 8;
  const STORAGE_KEY = 'brief-onboarding-state-v3';
  const params = new URLSearchParams(window.location.search);
  const token = params.get('t');

  // Render section catalog
  function renderSectionCatalog() {
    const grid = document.getElementById('sections-grid');
    if (!grid) return;
    grid.innerHTML = SECTION_CATALOG.map(s => `
      <label class="section-card">
        <input type="checkbox" name="sections.include" value="${s.id}" />
        <div class="name">${s.name}</div>
        <div class="desc">${s.desc}</div>
      </label>`).join('');

    // Populate hero + load_bearing dropdowns from selected sections
    function refreshDropdowns() {
      const selected = [...document.querySelectorAll('input[name="sections.include"]:checked')]
        .map(el => ({id: el.value, label: SECTION_CATALOG.find(s => s.id === el.value)?.name || el.value}));
      ['sections.hero_section', 'sections.load_bearing'].forEach(name => {
        const sel = document.querySelector(`select[name="${name}"]`);
        if (!sel) return;
        const cur = sel.value;
        sel.innerHTML = '<option value="">— choose —</option>' +
          selected.map(s => `<option value="${s.id}">${s.label}</option>`).join('');
        if (cur && selected.find(s => s.id === cur)) sel.value = cur;
      });
    }
    grid.addEventListener('change', refreshDropdowns);
    refreshDropdowns();
  }

  // Add-row helpers (only direct reports; customer ownership auto-derived from M365 post-sync)
  function setupAddRow(buttonId, containerId, fields) {
    const btn = document.getElementById(buttonId);
    const container = document.getElementById(containerId);
    if (!btn || !container) return;
    function addRow() {
      const row = document.createElement('div');
      row.className = 'report-row';
      row.innerHTML = fields.map(f => `<input type="${f.type || 'text'}" class="form-input" placeholder="${f.placeholder}" data-key="${f.key}" />`).join('');
      container.appendChild(row);
    }
    btn.addEventListener('click', addRow);
  }

  // Step navigation
  function showStep(targetId) {
    document.querySelectorAll('.onboarding-step').forEach(el => el.classList.add('hidden'));
    const target = document.getElementById(targetId);
    if (!target) return;
    target.classList.remove('hidden');
    window.scrollTo({top: 0, behavior: 'smooth'});

    // Progress bar
    const stepNum = parseInt(target.dataset.step || '0', 10);
    const progressWrap = document.getElementById('progress-wrap');
    if (stepNum > 0) {
      progressWrap.classList.remove('hidden');
      document.getElementById('progress-bar').style.width = `${(stepNum / TOTAL_STEPS) * 100}%`;
      document.getElementById('step-label').textContent = `Step ${stepNum} of ${TOTAL_STEPS}`;
      document.getElementById('step-name').textContent = target.dataset.section || '';
    } else {
      progressWrap.classList.add('hidden');
    }

    if (targetId === 'step-8') updateSummary();
  }

  function updateSummary() {
    const data = collectFormData();
    const div = document.getElementById('summary-content');
    if (!div) return;
    const name = data.identity?.name || '(your name)';
    const role = data.identity?.title || '';
    const sections = (data.sections?.include || []).length;
    const tone = data.format?.tone || 'exec_strategic';
    const cadence = data.delivery?.cadence || 'mon_fri';
    const sendTime = data.delivery?.send_time_local || '06:00';
    div.innerHTML = `
      <p><strong>${name}</strong>${role ? ' · ' + role : ''}</p>
      <p>${sections} sections · tone: <code>${tone}</code> · cadence: <code>${cadence}</code> · send: <code>${sendTime}</code></p>
    `;
  }

  function collectFormData() {
    const data = {};
    function setNested(obj, path, val) {
      const parts = path.split('.');
      let cur = obj;
      for (let i = 0; i < parts.length - 1; i++) {
        const key = parts[i];
        const next = parts[i + 1];
        if (/^\d+$/.test(next)) {
          if (!Array.isArray(cur[key])) cur[key] = [];
        } else {
          if (typeof cur[key] !== 'object' || cur[key] === null) cur[key] = {};
        }
        cur = cur[key];
      }
      const last = parts[parts.length - 1];
      if (/^\d+$/.test(last)) cur[parseInt(last, 10)] = val;
      else cur[last] = val;
    }
    function getNested(obj, path) {
      const parts = path.split('.');
      let cur = obj;
      for (const p of parts) {
        if (cur == null) return undefined;
        cur = /^\d+$/.test(p) ? cur[parseInt(p, 10)] : cur[p];
      }
      return cur;
    }
    document.querySelectorAll('input[name], textarea[name], select[name]').forEach(el => {
      const name = el.name;
      if (!name) return;
      if (el.type === 'checkbox') {
        if (el.checked) {
          if (name.includes('.')) {
            setNested(data, name, [...(getNested(data, name) || []), el.value]);
          } else {
            data[name] = [...(data[name] || []), el.value];
          }
        }
      } else if (el.type === 'radio') {
        if (el.checked && name) setNested(data, name, el.value);
      } else if (el.value !== '' && el.value != null) {
        setNested(data, name, el.value);
      }
    });

    // Reports table → org.direct_reports
    const reports = [...document.querySelectorAll('#reports-list .report-row')]
      .map(row => {
        const obj = {};
        row.querySelectorAll('input').forEach(inp => obj[inp.dataset.key] = inp.value);
        return obj;
      })
      .filter(r => r.name || r.email);
    if (reports.length) {
      data.org = data.org || {};
      data.org.direct_reports = reports;
    }

    if (token) data.token = token;
    return data;
  }

  // Submit
  async function submitForm() {
    const btn = document.getElementById('submit-btn');
    if (!btn) return;
    btn.disabled = true;
    btn.textContent = 'Building…';
    const payload = collectFormData();
    try {
      const r = await fetch('https://onboarding-worker.1404-io.workers.dev/onboarding/submit', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(payload),
      });
      let body = null;
      try { body = await r.json(); } catch (_) {}
      if (!r.ok) {
        const detail = body?.error || body?.detail || `HTTP ${r.status}`;
        throw new Error(detail);
      }
      document.getElementById('submit-result').classList.remove('hidden');
      btn.textContent = 'Built';
      localStorage.removeItem(STORAGE_KEY);
    } catch (e) {
      btn.disabled = false;
      btn.textContent = 'Build it →';
      alert(`Submit failed: ${e.message}\n\nYour answers are saved locally — try again or email holden@1404.io.`);
      console.error(e);
    }
  }

  // Pre-fill from token
  async function maybePrefill() {
    if (!token) return;
    try {
      const r = await fetch(`https://onboarding-worker.1404-io.workers.dev/onboarding/draft?token=${encodeURIComponent(token)}`);
      if (!r.ok) return;
      const draft = await r.json();
      document.getElementById('prefill-banner').classList.remove('hidden');
      applyDraft(draft);
    } catch (e) {
      console.warn('Pre-fill fetch failed', e);
    }
  }

  function applyDraft(draft) {
    function setVal(name, value) {
      if (value == null) return;
      const els = document.querySelectorAll(`[name="${name}"]`);
      els.forEach(el => {
        if (el.type === 'radio') {
          if (String(el.value) === String(value)) el.checked = true;
        } else if (el.type === 'checkbox') {
          if (Array.isArray(value) && value.includes(el.value)) {
            el.checked = true;
            const card = el.closest('.section-card, label');
            if (card) card.classList.add('prefilled');
          } else if (!Array.isArray(value) && String(el.value) === String(value)) {
            el.checked = true;
          }
        } else {
          el.value = value;
          el.classList.add('prefilled');
        }
      });
    }
    function flattenSet(prefix, obj) {
      for (const k of Object.keys(obj)) {
        if (k.startsWith('_')) continue;
        const path = prefix ? `${prefix}.${k}` : k;
        const v = obj[k];
        if (v && typeof v === 'object' && !Array.isArray(v)) flattenSet(path, v);
        else if (Array.isArray(v) && v.length && typeof v[0] === 'object') {
          // Handled separately for direct_reports
        } else setVal(path, v);
      }
    }
    flattenSet('', draft);

    // Apply nested arrays (direct reports)
    function fillNestedRows(containerId, arr) {
      const container = document.getElementById(containerId);
      if (!container || !Array.isArray(arr) || !arr.length) return;
      const template = container.firstElementChild;
      if (!template) return;
      container.innerHTML = '';
      arr.forEach(item => {
        const row = template.cloneNode(true);
        row.querySelectorAll('input').forEach(inp => {
          const key = inp.dataset.key;
          if (key && item[key] != null) {
            inp.value = item[key];
            inp.classList.add('prefilled');
          } else {
            inp.value = '';
          }
        });
        container.appendChild(row);
      });
    }
    fillNestedRows('reports-list', draft.org?.direct_reports);

    // Programmatic checkbox changes don't fire 'change' events, so the
    // hero/load_bearing select dropdowns (which populate from checked sections
    // via the grid's change listener) stay empty after prefill. Fire one
    // synthetic change event on the grid to refresh them.
    document.getElementById('sections-grid')?.dispatchEvent(new Event('change', {bubbles: true}));
  }

  // Render trigger menu
  function renderTriggerMenu() {
    const grid = document.getElementById('trigger-grid');
    if (!grid) return;
    grid.innerHTML = TRIGGER_MENU.map(t => `
      <label><input type="checkbox" name="red_flags" value="${t.id}" /> ${t.label}</label>
    `).join('');
  }

  // Wire up
  document.addEventListener('DOMContentLoaded', () => {
    renderSectionCatalog();
    renderTriggerMenu();
    setupAddRow('add-report', 'reports-list', [
      {key: 'name', placeholder: 'Name'},
      {key: 'email', type: 'email', placeholder: 'Email'},
      {key: 'title', placeholder: 'Title'},
      {key: 'lane', placeholder: 'Lane'},
    ]);

    document.querySelectorAll('.advance-btn, .back-btn').forEach(btn => {
      btn.addEventListener('click', () => showStep(btn.dataset.target));
    });
    document.getElementById('submit-btn')?.addEventListener('click', submitForm);

    // Persist progress
    document.addEventListener('input', () => {
      const snapshot = collectFormData();
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(snapshot)); } catch (e) {}
    });

    maybePrefill();
  });
</script>
