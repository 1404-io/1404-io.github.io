---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="1404 — Daily Brief"
  description="Design how your morning works. ~5 minutes."
  noindex={true}
>
  <div class="max-w-3xl mx-auto px-6 py-16">

    <!-- Intro screen (default visible) -->
    <div id="intro" class="onboarding-step">
      <p class="font-mono text-xs text-copper mb-4 tracking-wide">DAILY BRIEF</p>
      <h1 class="font-display text-4xl md:text-5xl text-text-primary mb-6 leading-tight">
        Most morning briefs fail because they list everything. Yours won't.
      </h1>
      <p class="text-text-body text-lg leading-relaxed mb-4">
        Six months from now, your morning starts with five minutes and a clear answer — what's on fire, who's waiting on you, what the day needs from <span class="text-copper">you</span>.
      </p>
      <p class="text-text-body text-lg leading-relaxed mb-6">
        Let's design that.
      </p>
      <div id="prefill-banner" class="hidden mb-6 p-4 border border-copper rounded-sm bg-bg-card">
        <p class="font-mono text-xs text-copper tracking-wide mb-2">WE'VE STARTED THE WORK</p>
        <p class="text-text-body text-sm">From our prior conversations, we've drafted answers where we could. You'll see those highlighted with a copper border — confirm what's right, change what's not.</p>
      </div>
      <p class="text-text-secondary text-sm mb-8">
        Your answers go directly to your 1404 onboarder. Nothing is shared externally.
      </p>
      <button class="advance-btn" data-target="step-1">
        Start &rarr;
      </button>
    </div>

    <!-- Progress bar -->
    <div id="progress-wrap" class="hidden sticky top-0 bg-bg pt-4 pb-2 z-10">
      <div class="flex justify-between text-xs text-text-muted font-mono mb-2">
        <span id="step-label">Step 1 of 8</span>
        <span id="step-name">Six months from now</span>
      </div>
      <div class="h-1 bg-border rounded">
        <div id="progress-bar" class="h-1 bg-copper rounded transition-all" style="width: 0%"></div>
      </div>
    </div>

    <!-- Step 1: Vision (the wishlist) -->
    <div id="step-1" class="onboarding-step hidden" data-section="Six months from now" data-step="1">
      <h2 class="font-display text-3xl text-text-primary mb-6">Six months from now</h2>
      <p class="text-text-body mb-6">Imagine your daily brief is doing its job perfectly. Your morning starts differently than today. <strong class="text-copper">What's changed?</strong></p>

      <label class="form-label">
        <textarea name="wishlist.future_state" class="form-input mb-8" rows="6" placeholder="The first thing I see every morning is..."></textarea>
      </label>

      <p class="text-text-body mb-4">And — what's the one <strong class="text-copper">number, person, or event</strong> you'd pay to know first thing every day?</p>

      <label class="form-label">
        <textarea name="wishlist.one_thing" class="form-input" rows="3" placeholder="Cash on hand, or which job hit a snag overnight, or whether Walgreens replied to my email..."></textarea>
      </label>

      <div class="step-nav">
        <span></span>
        <button class="advance-btn" data-target="step-2">Continue &rarr;</button>
      </div>
    </div>

    <!-- Step 2: Self-identity (role + outcomes) -->
    <div id="step-2" class="onboarding-step hidden" data-section="How you're held accountable" data-step="2">
      <h2 class="font-display text-3xl text-text-primary mb-6">How you're held accountable</h2>

      <div class="form-grid">
        <label class="form-label">Your full name
          <input type="text" name="identity.name" class="form-input" required />
        </label>

        <label class="form-label">Work email
          <input type="email" name="identity.email" class="form-input" required placeholder="you@company.com" />
        </label>

        <label class="form-label full">Title
          <input type="text" name="identity.title" class="form-input" required placeholder="VP of Operations / CEO / etc." />
        </label>

        <label class="form-label full">In one sentence, what's your job?
          <textarea name="identity.role_summary" class="form-input" rows="2" placeholder="Run X end-to-end, allocate capital, set strategic direction" required></textarea>
        </label>

        <label class="form-label full">Three outcomes you're judged on
          <input type="text" name="identity.outcomes_measured.0" class="form-input mb-2" placeholder="Outcome 1" />
          <input type="text" name="identity.outcomes_measured.1" class="form-input mb-2" placeholder="Outcome 2" />
          <input type="text" name="identity.outcomes_measured.2" class="form-input" placeholder="Outcome 3" />
        </label>
      </div>

      <div class="step-nav">
        <button class="back-btn" data-target="step-1">&larr; Back</button>
        <button class="advance-btn" data-target="step-3">Continue &rarr;</button>
      </div>
    </div>

    <!-- Step 3: Tuesday morning -->
    <div id="step-3" class="onboarding-step hidden" data-section="A normal Tuesday morning" data-step="3">
      <h2 class="font-display text-3xl text-text-primary mb-6">A normal Tuesday morning</h2>
      <p class="text-text-body mb-6">Walk us through it. When you wake, when you check email, where you read the brief, what you do with it, what's your first meeting, who you see first. <strong class="text-copper">This single answer drives most of the design.</strong></p>

      <label class="form-label">
        <textarea name="morning_workflow.tuesday_morning" class="form-input" rows="8" placeholder="I wake at 5:30, do email on my phone in bed, get to the office around 7. First thing I do is check..."></textarea>
      </label>

      <div class="step-nav">
        <button class="back-btn" data-target="step-2">&larr; Back</button>
        <button class="advance-btn" data-target="step-4">Continue &rarr;</button>
      </div>
    </div>

    <!-- Step 4: Team — direct report lanes -->
    <div id="step-4" class="onboarding-step hidden" data-section="Your team" data-step="4">
      <h2 class="font-display text-3xl text-text-primary mb-6">Your team</h2>
      <p class="text-text-body mb-6">For each direct report — name, email, title, and the part of the work they own (their "lane"). Names auto-fill from M365 once we connect; until then, give us what you know.</p>

      <div id="reports-list">
        <div class="report-row">
          <input type="text" class="form-input" placeholder="Name" data-key="name" />
          <input type="email" class="form-input" placeholder="Email" data-key="email" />
          <input type="text" class="form-input" placeholder="Title" data-key="title" />
          <input type="text" class="form-input" placeholder="Lane (what they own)" data-key="lane" />
        </div>
      </div>
      <button id="add-report" class="text-copper text-sm hover:text-copper-bright mt-2" type="button">+ Add another</button>

      <div class="step-nav">
        <button class="back-btn" data-target="step-3">&larr; Back</button>
        <button class="advance-btn" data-target="step-5">Continue &rarr;</button>
      </div>
    </div>

    <!-- Step 5: What's in the brief -->
    <div id="step-5" class="onboarding-step hidden" data-section="What's in your brief" data-step="5">
      <h2 class="font-display text-3xl text-text-primary mb-6">What's in your brief</h2>
      <p class="text-text-body mb-6">Pick the sections that matter to you, day one. Click to include.</p>

      <div id="sections-grid" class="sections-grid">
        <!-- Populated via JS from SECTION_CATALOG -->
      </div>

      <fieldset class="form-label mt-8">Which one is the FIRST THING you scan?
        <select name="sections.hero_section" class="form-input"></select>
      </fieldset>

      <fieldset class="form-label">Which section, if removed, would make the brief useless?
        <select name="sections.load_bearing" class="form-input"></select>
      </fieldset>

      <p class="text-text-secondary text-sm mt-6">
        Once we connect Spectrum + Procore (Phase 2, ~30–45 days), your brief gets four more sections: manpower loading, materials in motion, EOS scorecard live, bid pipeline. We'll loop back to ask which of those you want then.
      </p>

      <div class="step-nav">
        <button class="back-btn" data-target="step-4">&larr; Back</button>
        <button class="advance-btn" data-target="step-6">Continue &rarr;</button>
      </div>
    </div>

    <!-- Step 6: Triggers + KPIs -->
    <div id="step-6" class="onboarding-step hidden" data-section="Triggers and numbers" data-step="6">
      <h2 class="font-display text-3xl text-text-primary mb-6">Triggers and numbers</h2>

      <fieldset class="form-label">What's a "stop the day, call me right now" alert?
        <p class="text-text-muted text-xs mb-3">Pick from the menu, or write your own below.</p>
        <div id="trigger-grid" class="checkbox-group"></div>
      </fieldset>

      <label class="form-label mt-4">Other red-flag conditions (free text — one per line)
        <textarea name="red_flags_custom" class="form-input" rows="3" placeholder="OSHA notice on any site&#10;Key foreman walks off"></textarea>
      </label>

      <label class="form-label mt-6">Numbers you watch obsessively (up to 4)
        <p class="text-text-muted text-xs mb-2">These become the KPI tiles at the top of your brief.</p>
        <input type="text" name="kpis_top.0" class="form-input mb-2" placeholder="Cash on hand" />
        <input type="text" name="kpis_top.1" class="form-input mb-2" placeholder="Past due AR" />
        <input type="text" name="kpis_top.2" class="form-input mb-2" placeholder="Backlog $" />
        <input type="text" name="kpis_top.3" class="form-input" placeholder="GM %" />
      </label>

      <div class="step-nav">
        <button class="back-btn" data-target="step-5">&larr; Back</button>
        <button class="advance-btn" data-target="step-7">Continue &rarr;</button>
      </div>
    </div>

    <!-- Step 7: Rhythm & format -->
    <div id="step-7" class="onboarding-step hidden" data-section="Rhythm and format" data-step="7">
      <h2 class="font-display text-3xl text-text-primary mb-6">Rhythm and format</h2>

      <fieldset class="form-label">Tone
        <div class="radio-card-group mt-3">
          <label class="radio-card">
            <input type="radio" name="format.tone" value="add_friendly" />
            <strong>ADD-friendly</strong>
            <span>3–5 items per section, action-first, scannable, color-coded approvals.</span>
          </label>
          <label class="radio-card">
            <input type="radio" name="format.tone" value="exec_strategic" checked />
            <strong>Exec strategic</strong>
            <span>BLUF + KPIs + risks + drilldowns. 5–7 sections, more analysis.</span>
          </label>
          <label class="radio-card">
            <input type="radio" name="format.tone" value="deep_data" />
            <strong>Deep data</strong>
            <span>Workbook-style with all tables expanded. Use this if you like to dig.</span>
          </label>
        </div>
      </fieldset>

      <div class="form-grid mt-8">
        <label class="form-label">Send time (local)
          <input type="time" name="delivery.send_time_local" class="form-input" value="06:00" />
        </label>

        <fieldset class="form-label">Cadence
          <div class="radio-group">
            <label><input type="radio" name="delivery.cadence" value="mon_fri" checked /> Weekdays only</label>
            <label><input type="radio" name="delivery.cadence" value="daily" /> 7 days</label>
            <label><input type="radio" name="delivery.cadence" value="mon_wed_fri" /> Mon / Wed / Fri</label>
            <label><input type="radio" name="delivery.cadence" value="on_demand" /> On-demand only</label>
          </div>
        </fieldset>

        <fieldset class="form-label">Where do you read it?
          <div class="radio-group">
            <label><input type="radio" name="morning_workflow.device" value="laptop" checked /> Laptop</label>
            <label><input type="radio" name="morning_workflow.device" value="phone" /> Phone</label>
            <label><input type="radio" name="morning_workflow.device" value="printed" /> Printed</label>
          </div>
        </fieldset>

        <fieldset class="form-label">How long do you give it?
          <div class="radio-group">
            <label><input type="radio" name="morning_workflow.scan_time_minutes" value="5" /> 5 min — gimme the answer</label>
            <label><input type="radio" name="morning_workflow.scan_time_minutes" value="10" checked /> 10 min — quick scan</label>
            <label><input type="radio" name="morning_workflow.scan_time_minutes" value="20" /> 20 min — I'll dig in</label>
          </div>
        </fieldset>
      </div>

      <div class="step-nav">
        <button class="back-btn" data-target="step-6">&larr; Back</button>
        <button class="advance-btn" data-target="step-8">Continue &rarr;</button>
      </div>
    </div>

    <!-- Step 8: Boundaries + approvals -->
    <div id="step-8" class="onboarding-step hidden" data-section="Boundaries" data-step="8">
      <h2 class="font-display text-3xl text-text-primary mb-6">Boundaries</h2>

      <p class="text-text-body mb-4">Approvals come to you. Set the line.</p>

      <div class="form-grid">
        <label class="form-label">PO threshold (approve all above $)
          <input type="number" name="approvals.thresholds.po_above" class="form-input" placeholder="5000" />
        </label>
        <label class="form-label">Expense threshold ($)
          <input type="number" name="approvals.thresholds.expense_above" class="form-input" placeholder="2500" />
        </label>
      </div>

      <label class="form-label mt-8">What should NOT be in your brief?
        <p class="text-text-muted text-xs mb-2">Free text. Examples: other directors' personnel issues, exec-only comms, not-your-customer pricing, board-level financials, M&amp;A discussions.</p>
        <textarea name="boundaries.exclude_topics" class="form-input" rows="3"></textarea>
      </label>

      <fieldset class="form-label mt-6">Data tier
        <div class="radio-group">
          <label><input type="radio" name="boundaries.data_tier" value="T1" checked /> T1 — full P&amp;L + payroll detail (CEO/CFO)</label>
          <label><input type="radio" name="boundaries.data_tier" value="T2" /> T2 — full P&amp;L, no payroll detail</label>
          <label><input type="radio" name="boundaries.data_tier" value="T3" /> T3 — P&amp;L + own department</label>
          <label><input type="radio" name="boundaries.data_tier" value="T4" /> T4 — P&amp;L overview only</label>
          <label><input type="radio" name="boundaries.data_tier" value="T5" /> T5 — % to plan only</label>
        </div>
      </fieldset>

      <fieldset class="form-label mt-6">Who can see this brief besides you?
        <div class="checkbox-group">
          <label><input type="checkbox" name="boundaries.shared_with" value="self" checked /> Just me</label>
          <label><input type="checkbox" name="boundaries.shared_with" value="EA" /> My EA</label>
          <label><input type="checkbox" name="boundaries.shared_with" value="manager" /> My manager</label>
          <label><input type="checkbox" name="boundaries.shared_with" value="team" /> My team</label>
        </div>
      </fieldset>

      <!-- Summary block -->
      <div class="mt-12 p-6 border border-copper rounded-sm bg-bg-card">
        <p class="font-mono text-xs text-copper tracking-wide mb-3">YOUR BRIEF, AT A GLANCE</p>
        <div id="summary-content" class="text-text-body text-sm space-y-2"></div>
      </div>

      <div class="step-nav mt-8">
        <button class="back-btn" data-target="step-7">&larr; Back</button>
        <button id="submit-btn" class="submit-btn">Build it &rarr;</button>
      </div>

      <div id="submit-result" class="hidden mt-6 p-6 border border-copper rounded-sm bg-bg-card">
        <p class="font-mono text-xs text-copper tracking-wide mb-3">DONE</p>
        <p class="text-text-body">Your v0 brief lands in your inbox tomorrow morning. We'll be in touch.</p>
      </div>
    </div>

  </div>
</PageLayout>

<style is:global>
  .onboarding-step {
    min-height: 60vh;
    animation: fadeIn 200ms ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .form-grid { grid-template-columns: 1fr 1fr; }
    .form-grid .form-label.full { grid-column: 1 / -1; }
  }
  .form-label {
    display: block;
    color: var(--color-text-body);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }
  .form-input {
    width: 100%;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    padding: 0.75rem 1rem;
    font-size: 1rem;
    margin-top: 0.4rem;
    border-radius: 2px;
    transition: border-color 200ms;
  }
  .form-input:focus {
    outline: none;
    border-color: var(--color-copper);
  }
  textarea.form-input { resize: vertical; min-height: 80px; }
  .radio-group, .checkbox-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .radio-group label, .checkbox-group label {
    color: var(--color-text-body);
    font-size: 0.9rem;
    cursor: pointer;
  }
  .radio-group input, .checkbox-group input {
    margin-right: 0.5rem;
    accent-color: var(--color-copper);
  }
  .radio-card-group {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .radio-card-group { grid-template-columns: repeat(3, 1fr); }
  }
  .radio-card {
    display: block;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: var(--color-bg-card);
    cursor: pointer;
    transition: border-color 200ms;
  }
  .radio-card:has(input:checked) {
    border-color: var(--color-copper);
    background: var(--color-bg-surface);
  }
  .radio-card input { display: none; }
  .radio-card strong {
    display: block;
    color: var(--color-text-primary);
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }
  .radio-card span {
    display: block;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    line-height: 1.4;
  }
  .step-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .advance-btn, .submit-btn, .back-btn {
    padding: 0.85rem 2rem;
    font-size: 0.95rem;
    border-radius: 2px;
    cursor: pointer;
    font-family: inherit;
    transition: background 200ms;
  }
  .advance-btn, .submit-btn {
    background: var(--color-copper);
    color: var(--color-bg);
    border: none;
    font-weight: 600;
  }
  .advance-btn:hover, .submit-btn:hover {
    background: var(--color-copper-bright);
  }
  .back-btn {
    background: transparent;
    color: var(--color-text-body);
    border: 1px solid var(--color-border);
  }
  .back-btn:hover {
    border-color: var(--color-copper);
    color: var(--color-text-primary);
  }
  .report-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  @media (max-width: 767px) {
    .report-row { grid-template-columns: 1fr; }
  }
  .sections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.6rem;
  }
  .section-card {
    padding: 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    cursor: pointer;
    background: var(--color-bg-card);
    transition: all 200ms;
  }
  .section-card:has(input:checked) {
    border-color: var(--color-copper);
    background: var(--color-bg-surface);
  }
  .section-card input { display: none; }
  .section-card .name {
    font-weight: 600;
    color: var(--color-text-primary);
    font-size: 0.85rem;
    margin-bottom: 0.25rem;
  }
  .section-card .desc {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.35;
    margin-bottom: 0.4rem;
  }
  .section-card .section-tags {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
    margin-top: 0.3rem;
  }
  .section-tag {
    font-size: 0.6rem;
    background: var(--color-bg-surface);
    color: var(--color-text-muted);
    padding: 0.1rem 0.4rem;
    border-radius: 2px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  /* Pre-fill highlighting */
  .prefilled {
    border-color: var(--color-copper) !important;
    background: var(--color-bg-surface);
  }
  .prefill-badge {
    display: inline-block;
    background: var(--color-copper);
    color: var(--color-bg);
    font-size: 0.65rem;
    padding: 0.1rem 0.45rem;
    border-radius: 2px;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-left: 0.5rem;
    vertical-align: middle;
    text-transform: uppercase;
  }
  .prefill-source {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
    font-style: italic;
  }
</style>

<script>
  // Section catalog — Day-1 sections only (universal, no Spectrum/Procore dependency).
  // Phase-2 sections (manpower_loading, materials_in_motion, eos_scorecard_live, etc.)
  // are intentionally absent — we'll re-ask once those integrations land.
  const SECTION_CATALOG = [
    {id: 'one_liner', name: '30-second read', desc: 'Single-sentence summary at the top.'},
    {id: 'red_banner', name: 'Red banner', desc: 'Fires only if a trigger matches.'},
    {id: 'actions_today', name: 'Top 3 actions today', desc: 'Time-stamped things you must do today.'},
    {id: 'calendar_with_prep', name: 'Calendar with prep', desc: 'Today\'s meetings linked to live open threads.'},
    {id: 'inbox_needs_response', name: 'Inbox triage', desc: 'Strict-filter emails that need your reply.'},
    {id: 'conversations', name: 'Conversations needing reply', desc: 'Filtered email triage with FITFO answers.'},
    {id: 'approvals_needed', name: 'Approvals waiting', desc: 'Timesheets, expenses, POs, change orders — color-coded.'},
    {id: 'direct_report_activity', name: 'Direct report activity', desc: 'Per-person card: sentiment, topics, pending for you.'},
    {id: 'team_pulse', name: 'Team pulse + standup agenda', desc: 'Per-report standup question.'},
    {id: 'what_changed', name: 'What changed since last brief', desc: 'New wins, closed items, aging, first-flagged patterns.'},
    {id: 'decisions_today', name: 'Decisions today', desc: 'Recommendations + cost of inaction.'},
    {id: 'risks', name: 'Risks & systemic patterns', desc: 'Cross-source pattern detection.'},
    {id: 'core_values_pulse', name: 'Core values pulse', desc: 'Behavior callouts with quoted evidence.'},
  ];

  // Trigger menu — for the red-flag question
  const TRIGGER_MENU = [
    {id: 'cash_runway_critical', label: 'Cash below half of week\'s outflow'},
    {id: 'customer_escalation', label: 'Escalation language from high-revenue customer'},
    {id: 'aged_ar_writeoff_risk', label: 'AR aged 91+ days above threshold'},
    {id: 'approvals_pile_up', label: 'Many approvals waiting (your team can\'t move)'},
    {id: 'manpower_out_of_band', label: 'Manpower forecast outside ±10% band'},
    {id: 'material_delivery_missed', label: 'Material delivery missed for active job'},
    {id: 'submittal_late', label: 'Submittal past spec window'},
    {id: 'rfi_overdue', label: 'RFI open >7 days'},
    {id: 'eos_measurable_red', label: 'EOS scorecard row red 2 weeks running'},
    {id: 'critical_email_buried', label: 'Email from flagged sender, buried in M365 group'},
    {id: 'rock_off_track', label: 'Quarterly rock off track > 2 weeks'},
  ];

  const TOTAL_STEPS = 8;
  const STORAGE_KEY = 'brief-onboarding-state-v3';
  const params = new URLSearchParams(window.location.search);
  const token = params.get('t');

  // Render section catalog
  function renderSectionCatalog() {
    const grid = document.getElementById('sections-grid');
    if (!grid) return;
    grid.innerHTML = SECTION_CATALOG.map(s => `
      <label class="section-card">
        <input type="checkbox" name="sections.include" value="${s.id}" />
        <div class="name">${s.name}</div>
        <div class="desc">${s.desc}</div>
      </label>`).join('');

    // Populate hero + load_bearing dropdowns from selected sections
    function refreshDropdowns() {
      const selected = [...document.querySelectorAll('input[name="sections.include"]:checked')]
        .map(el => ({id: el.value, label: SECTION_CATALOG.find(s => s.id === el.value)?.name || el.value}));
      ['sections.hero_section', 'sections.load_bearing'].forEach(name => {
        const sel = document.querySelector(`select[name="${name}"]`);
        if (!sel) return;
        const cur = sel.value;
        sel.innerHTML = '<option value="">— choose —</option>' +
          selected.map(s => `<option value="${s.id}">${s.label}</option>`).join('');
        if (cur && selected.find(s => s.id === cur)) sel.value = cur;
      });
    }
    grid.addEventListener('change', refreshDropdowns);
    refreshDropdowns();
  }

  // Add-row helpers (only direct reports; customer ownership auto-derived from M365 post-sync)
  function setupAddRow(buttonId, containerId, fields) {
    const btn = document.getElementById(buttonId);
    const container = document.getElementById(containerId);
    if (!btn || !container) return;
    function addRow() {
      const row = document.createElement('div');
      row.className = 'report-row';
      row.innerHTML = fields.map(f => `<input type="${f.type || 'text'}" class="form-input" placeholder="${f.placeholder}" data-key="${f.key}" />`).join('');
      container.appendChild(row);
    }
    btn.addEventListener('click', addRow);
  }

  // Step navigation
  function showStep(targetId) {
    document.querySelectorAll('.onboarding-step').forEach(el => el.classList.add('hidden'));
    const target = document.getElementById(targetId);
    if (!target) return;
    target.classList.remove('hidden');
    window.scrollTo({top: 0, behavior: 'smooth'});

    // Progress bar
    const stepNum = parseInt(target.dataset.step || '0', 10);
    const progressWrap = document.getElementById('progress-wrap');
    if (stepNum > 0) {
      progressWrap.classList.remove('hidden');
      document.getElementById('progress-bar').style.width = `${(stepNum / TOTAL_STEPS) * 100}%`;
      document.getElementById('step-label').textContent = `Step ${stepNum} of ${TOTAL_STEPS}`;
      document.getElementById('step-name').textContent = target.dataset.section || '';
    } else {
      progressWrap.classList.add('hidden');
    }

    if (targetId === 'step-8') updateSummary();
  }

  function updateSummary() {
    const data = collectFormData();
    const div = document.getElementById('summary-content');
    if (!div) return;
    const name = data.identity?.name || '(your name)';
    const role = data.identity?.title || '';
    const sections = (data.sections?.include || []).length;
    const tone = data.format?.tone || 'exec_strategic';
    const cadence = data.delivery?.cadence || 'mon_fri';
    const sendTime = data.delivery?.send_time_local || '06:00';
    div.innerHTML = `
      <p><strong>${name}</strong>${role ? ' · ' + role : ''}</p>
      <p>${sections} sections · tone: <code>${tone}</code> · cadence: <code>${cadence}</code> · send: <code>${sendTime}</code></p>
      <p class="text-text-muted text-xs">Hit Build it and your v0 lands in your inbox tomorrow morning.</p>
    `;
  }

  function collectFormData() {
    const data = {};
    function setNested(obj, path, val) {
      const parts = path.split('.');
      let cur = obj;
      for (let i = 0; i < parts.length - 1; i++) {
        const key = parts[i];
        const next = parts[i + 1];
        if (/^\d+$/.test(next)) {
          if (!Array.isArray(cur[key])) cur[key] = [];
        } else {
          if (typeof cur[key] !== 'object' || cur[key] === null) cur[key] = {};
        }
        cur = cur[key];
      }
      const last = parts[parts.length - 1];
      if (/^\d+$/.test(last)) cur[parseInt(last, 10)] = val;
      else cur[last] = val;
    }
    function getNested(obj, path) {
      const parts = path.split('.');
      let cur = obj;
      for (const p of parts) {
        if (cur == null) return undefined;
        cur = /^\d+$/.test(p) ? cur[parseInt(p, 10)] : cur[p];
      }
      return cur;
    }
    document.querySelectorAll('input[name], textarea[name], select[name]').forEach(el => {
      const name = el.name;
      if (!name) return;
      if (el.type === 'checkbox') {
        if (el.checked) {
          if (name.includes('.')) {
            setNested(data, name, [...(getNested(data, name) || []), el.value]);
          } else {
            data[name] = [...(data[name] || []), el.value];
          }
        }
      } else if (el.type === 'radio') {
        if (el.checked && name) setNested(data, name, el.value);
      } else if (el.value !== '' && el.value != null) {
        setNested(data, name, el.value);
      }
    });

    // Reports table → org.direct_reports
    const reports = [...document.querySelectorAll('#reports-list .report-row')]
      .map(row => {
        const obj = {};
        row.querySelectorAll('input').forEach(inp => obj[inp.dataset.key] = inp.value);
        return obj;
      })
      .filter(r => r.name || r.email);
    if (reports.length) {
      data.org = data.org || {};
      data.org.direct_reports = reports;
    }

    if (token) data.token = token;
    return data;
  }

  // Submit
  async function submitForm() {
    const btn = document.getElementById('submit-btn');
    if (!btn) return;
    btn.disabled = true;
    btn.textContent = 'Building…';
    const payload = collectFormData();
    try {
      const r = await fetch('https://onboarding-worker.1404-io.workers.dev/onboarding/submit', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(payload),
      });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      document.getElementById('submit-result').classList.remove('hidden');
      btn.textContent = 'Built';
      localStorage.removeItem(STORAGE_KEY);
    } catch (e) {
      btn.disabled = false;
      btn.textContent = 'Build it →';
      alert(`Submit failed: ${e.message}. Your answers are saved locally — try again.`);
      console.error(e);
    }
  }

  // Pre-fill from token
  async function maybePrefill() {
    if (!token) return;
    try {
      const r = await fetch(`https://onboarding-worker.1404-io.workers.dev/onboarding/draft?token=${encodeURIComponent(token)}`);
      if (!r.ok) return;
      const draft = await r.json();
      document.getElementById('prefill-banner').classList.remove('hidden');
      applyDraft(draft);
    } catch (e) {
      console.warn('Pre-fill fetch failed', e);
    }
  }

  function applyDraft(draft) {
    function setVal(name, value) {
      if (value == null) return;
      const els = document.querySelectorAll(`[name="${name}"]`);
      els.forEach(el => {
        if (el.type === 'radio') {
          if (String(el.value) === String(value)) el.checked = true;
        } else if (el.type === 'checkbox') {
          if (Array.isArray(value) && value.includes(el.value)) {
            el.checked = true;
            const card = el.closest('.section-card, label');
            if (card) card.classList.add('prefilled');
          } else if (!Array.isArray(value) && String(el.value) === String(value)) {
            el.checked = true;
          }
        } else {
          el.value = value;
          el.classList.add('prefilled');
        }
      });
    }
    function flattenSet(prefix, obj) {
      for (const k of Object.keys(obj)) {
        if (k.startsWith('_')) continue;
        const path = prefix ? `${prefix}.${k}` : k;
        const v = obj[k];
        if (v && typeof v === 'object' && !Array.isArray(v)) flattenSet(path, v);
        else if (Array.isArray(v) && v.length && typeof v[0] === 'object') {
          // Handled separately for direct_reports
        } else setVal(path, v);
      }
    }
    flattenSet('', draft);

    // Apply nested arrays (direct reports)
    function fillNestedRows(containerId, arr) {
      const container = document.getElementById(containerId);
      if (!container || !Array.isArray(arr) || !arr.length) return;
      const template = container.firstElementChild;
      if (!template) return;
      container.innerHTML = '';
      arr.forEach(item => {
        const row = template.cloneNode(true);
        row.querySelectorAll('input').forEach(inp => {
          const key = inp.dataset.key;
          if (key && item[key] != null) {
            inp.value = item[key];
            inp.classList.add('prefilled');
          } else {
            inp.value = '';
          }
        });
        container.appendChild(row);
      });
    }
    fillNestedRows('reports-list', draft.org?.direct_reports);
  }

  // Render trigger menu
  function renderTriggerMenu() {
    const grid = document.getElementById('trigger-grid');
    if (!grid) return;
    grid.innerHTML = TRIGGER_MENU.map(t => `
      <label><input type="checkbox" name="red_flags" value="${t.id}" /> ${t.label}</label>
    `).join('');
  }

  // Wire up
  document.addEventListener('DOMContentLoaded', () => {
    renderSectionCatalog();
    renderTriggerMenu();
    setupAddRow('add-report', 'reports-list', [
      {key: 'name', placeholder: 'Name'},
      {key: 'email', type: 'email', placeholder: 'Email'},
      {key: 'title', placeholder: 'Title'},
      {key: 'lane', placeholder: 'Lane'},
    ]);

    document.querySelectorAll('.advance-btn, .back-btn').forEach(btn => {
      btn.addEventListener('click', () => showStep(btn.dataset.target));
    });
    document.getElementById('submit-btn')?.addEventListener('click', submitForm);

    // Persist progress
    document.addEventListener('input', () => {
      const snapshot = collectFormData();
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(snapshot)); } catch (e) {}
    });

    maybePrefill();
  });
</script>
