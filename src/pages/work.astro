---
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTABanner from '../components/CTABanner.astro';

// Deliverable cards — add real entries here as they're ready.
// Each card: { title, category, description, thumbnail? }
const deliverables: {
  title: string;
  category: string;
  description: string;
  thumbnail?: string;
}[] = [];

// Placeholder cards shown when there aren't enough real deliverables yet
const placeholderCount = Math.max(0, 3 - deliverables.length);

// The kinds of work a partnership produces.
const workTypes = [
  { label: 'Executive operations', desc: 'Morning briefs, email triage, meeting prep, scorecards.' },
  { label: 'Financial intelligence', desc: 'Cash flow, job costing, WIP schedules, monthly financials.' },
  { label: 'Business development', desc: 'Pipeline, prospecting, outreach, proposals.' },
  { label: 'Custom software', desc: 'Unified systems built around how your company operates.' },
  { label: 'Orchestration', desc: 'The tools you already run, connected so they work as one.' },
  { label: 'AI strategy', desc: 'A clear plan built from your growth goals.' },
];
---

<PageLayout
  title="Work — 1404 | What we build"
  description="Real output from our work with clients. Executive reports, financial analysis, custom software, and more."
>
  <!-- Header -->
  <section class="max-w-5xl mx-auto px-6 pt-32 pb-16 md:pt-40 md:pb-20">
    <SectionHeading
      title="Work"
      subtitle="Real output from our work with clients. These are actual deliverables produced during live partnerships."
    />

    <div class="space-y-6 text-text-body text-base leading-relaxed">
      <p>
        The best way to understand what we do is to see what it produces. Below are examples of actual work delivered for real clients. Each one was built by us, reviewed by our team, and put to use in the business.
      </p>
      <p>
        Every example below is real work produced as part of a live partnership.
      </p>
    </div>
  </section>

  <!-- Deliverables Grid -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-6 py-24 md:py-32">
      <SectionHeading title="Deliverables" />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {/* Real deliverable cards */}
        {deliverables.map((item) => (
          <div class="border border-border-light rounded-sm bg-bg-card overflow-hidden">
            {item.thumbnail ? (
              <img src={item.thumbnail} alt={item.title} class="w-full h-48 object-cover" />
            ) : (
              <div class="w-full h-48 bg-bg-surface flex items-center justify-center">
                <span class="text-text-muted text-sm font-mono">Preview</span>
              </div>
            )}
            <div class="p-6">
              <p class="font-mono text-xs text-copper mb-2 tracking-wide">{item.category}</p>
              <h3 class="font-display text-lg text-text-primary mb-2">{item.title}</h3>
              <p class="text-text-secondary text-sm leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}

        {/* Placeholder cards */}
        {Array.from({ length: placeholderCount }).map(() => (
          <div class="border border-border-light rounded-sm bg-bg-card overflow-hidden">
            <div class="w-full h-48 bg-bg-surface flex items-center justify-center">
              <div class="w-10 h-10 border border-border-light rounded-sm flex items-center justify-center">
                <span class="text-text-muted text-lg">+</span>
              </div>
            </div>
            <div class="p-6">
              <p class="font-mono text-xs text-text-muted mb-2 tracking-wide">COMING SOON</p>
              <h3 class="font-display text-lg text-text-muted mb-2">New deliverable</h3>
              <p class="text-text-muted text-sm leading-relaxed">
                More examples will be added here as client partnerships produce shareable work.
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What You'll See Here -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-6 py-24 md:py-32">
      <SectionHeading title="What you'll find here" />

      <p class="text-text-body text-base leading-relaxed mb-12">
        A partnership produces a lot of different work. As we add deliverables to this page, here's the kind of thing you can expect to see.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {workTypes.map((w) => (
          <div class="border border-border-light rounded-sm px-5 py-4 bg-bg-card">
            <p class="font-mono text-xs text-copper mb-1 tracking-wide">{w.label}</p>
            <p class="text-text-secondary text-sm">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABanner />
</PageLayout>
